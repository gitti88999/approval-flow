# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key used by the approval-agent's LLM provider (LLM_PROVIDER=groq).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider approval-agent uses: "groq" (real) or "stub" (deterministic,
# offline, no key needed — used in CI and for local dev without an API key).
LLM_PROVIDER=groq
