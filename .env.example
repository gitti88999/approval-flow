# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key used by the approval-agent's LLM provider (LLM_PROVIDER=groq).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider approval-agent uses: "groq" (real) or "stub" (deterministic,
# offline, no key needed — used in CI and for local dev without an API key).
LLM_PROVIDER=groq

# Signing secret for the gateway's self-signed JWTs. Any random string works locally;
# use a long random value in a real deployment.
JWT_SECRET=change-this-to-a-random-string

# Bootstrapped on first startup so there's always a way into the system; register additional
# accounts via POST /auth/register after that (see README's Authentication section).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
